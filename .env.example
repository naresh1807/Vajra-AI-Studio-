# ---- Vajra AI local configuration ----
# Copy to .env and fill in. NEVER commit .env.

# NVIDIA NIM / Nemotron (primary model provider)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Verified working on integrate.api.nvidia.com (Aug 2026): nemotron-3-super-120b-a12b,
# nemotron-3.5-lightning-30b-a3b (faster), nemotron-3-nano-30b-a3b (smallest).
VAJRA_NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# Local fallback model (OpenAI-compatible endpoint: Ollama / vLLM / llama.cpp)
VAJRA_LOCAL_MODEL=qwen2.5-coder
VAJRA_LOCAL_BASE_URL=http://localhost:11434/v1

# Core / API
VAJRA_HOST=127.0.0.1
VAJRA_PORT=8760
# Set true to bind 0.0.0.0 so a phone on the same Wi-Fi can reach /mobile.
# The pairing token is the only guard - only on a trusted LAN.
VAJRA_BIND_LAN=false
VAJRA_DB_PATH=./data/vajra.db
VAJRA_LOG_DIR=./logs

# Pairing: shared secret the Desktop/Android/VS Code clients present to the local Core
VAJRA_PAIRING_TOKEN=change-me-local-only

# Autonomy guardrails
VAJRA_MAX_RETRIES=2
VAJRA_AUTONOMY_ENABLED=true
