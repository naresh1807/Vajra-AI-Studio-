# ---- Vajra AI local configuration ----
# Copy to .env and fill in. NEVER commit .env.

# NVIDIA NIM / Nemotron (primary model provider)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Verified working on integrate.api.nvidia.com (Aug 2026): nemotron-3-super-120b-a12b,
# nemotron-3.5-lightning-30b-a3b (faster), nemotron-3-nano-30b-a3b (smallest).
#
# VAJRA_NEMOTRON_MODEL - chat / inline-assist / completion. lightning-30b: super-120b
#   is strongest but intermittently 503s; lightning-30b is far more reliable + faster.
# VAJRA_AGENT_MODEL - autonomous agent runs (planner + coder/tester/debugger, and the
#   computer/osdev/security agents). These drive a multi-step tool loop where a weaker
#   model stalls (repeats read-only calls, never writes), so this defaults to the
#   strongest model and accepts the occasional 503 (the local fallback covers those).
#   Set it equal to VAJRA_NEMOTRON_MODEL to use one model everywhere.
VAJRA_NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
VAJRA_AGENT_MODEL=nvidia/nemotron-3-super-120b-a12b

# Local fallback model (OpenAI-compatible endpoint: Ollama / vLLM / llama.cpp)
VAJRA_LOCAL_MODEL=qwen2.5-coder
VAJRA_LOCAL_BASE_URL=http://localhost:11434/v1

# ---- Optional secondary model tier ----
# Tried between NVIDIA (primary) and the local fallback. Any OpenAI-compatible
# /chat/completions endpoint. Leave VAJRA_SECONDARY_BASE_URL empty to disable.
#
# Worked example - GitHub Models (https://github.com/marketplace/models): one
# GitHub Personal Access Token (fine-grained, "models:read" scope) unlocks many
# models - OpenAI, Anthropic, Meta, xAI, Mistral, Phi. Free, rate-limited.
#   VAJRA_SECONDARY_PROVIDER=github_models
#   VAJRA_SECONDARY_BASE_URL=https://models.github.ai/inference
#   VAJRA_SECONDARY_MODEL=openai/gpt-4o-mini
#   VAJRA_SECONDARY_API_KEY=github_pat_...
#
# NOTE: the GitHub *Copilot* editor API (api.githubcopilot.com) is a different
# thing - its terms limit it to official Copilot editor plugins, so it is not
# wired here. Use GitHub Models above, or any OpenAI-compatible provider
# (OpenAI, OpenRouter, Together, Groq, ...).
VAJRA_SECONDARY_PROVIDER=
VAJRA_SECONDARY_BASE_URL=
VAJRA_SECONDARY_MODEL=
VAJRA_SECONDARY_API_KEY=

# RAG embeddings. Leave VAJRA_EMBED_BASE_URL empty for the offline lexical
# index (no network). Point it at any OpenAI-compatible /embeddings endpoint
# (NIM: https://integrate.api.nvidia.com/v1  |  Ollama: http://localhost:11434/v1).
VAJRA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
VAJRA_EMBED_BASE_URL=
VAJRA_EMBED_API_KEY_ENV=NVIDIA_API_KEY

# Core / API
VAJRA_HOST=127.0.0.1
VAJRA_PORT=8760
# Set true to bind 0.0.0.0 so a phone on the same Wi-Fi can reach /mobile.
# The pairing token is the only guard - only on a trusted LAN.
VAJRA_BIND_LAN=false
VAJRA_DB_PATH=./data/vajra.db
VAJRA_LOG_DIR=./logs

# Auth: LEAVE VAJRA_PAIRING_TOKEN UNSET. On first run the Core generates a strong
# random device secret in data/device.json - the same-machine clients use it.
# VAJRA_PAIRING_TOKEN=
#
# Phones / other machines log in with a password. Set it in Studio
# ("Vajra: Set Password"), or here to skip the prompt (min 6 chars):
# VAJRA_PASSWORD=

# Autonomy guardrails
VAJRA_MAX_RETRIES=2
VAJRA_AUTONOMY_ENABLED=true
