{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Studio window: bundled UI, folder-picker dialog, and the vajra-api sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "vajra-api", "cmd": "vajra-api", "args": true }]
    }
  ]
}
