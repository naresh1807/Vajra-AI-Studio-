{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vajra AI Studio",
  "version": "0.2.0",
  "identifier": "ai.vajra.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Vajra AI Studio",
        "width": 1360,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:8760 ws://127.0.0.1:8760 http://localhost:8760 ws://localhost:8760"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Vajra AI",
    "shortDescription": "Private local-first AI-native IDE and computer agent"
  },
  "plugins": {}
}
